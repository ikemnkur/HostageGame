# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hostage_chess_game
DB_CONNECTION_LIMIT=10

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Admin panel ─────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-long-random-secret

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Email (Amazon SES SMTP) ─────────────────────────────────
# Leave blank to disable email sending (registration still works without it)
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASSWORD=
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Hostage Chess Game

# ─── Email verification ───────────────────────────────────────
VERIFICATION_CODE_EXPIRY_MINUTES=30
